{
  "name": "wpilgenerator",
  "description": "A custom generator to produce and publish list of icons to the vscode-icons wiki",
  "version": "0.13.2",
  "license": "MIT",
  "author": {
    "email": "jimikar@gmail.com",
    "name": "Dimitris \"Jimi\" Charalampidis"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vscode-icons/wpilgenerator"
  },
  "bugs": {
    "url": "https://github.com/vscode-icons/wpilgenerator/issues"
  },
  "engines": {
    "node": ">=22.*"
  },
  "main": "lib/wpilgen.js",
  "bin": {
    "wpilgen": "lib/wpilgen.js"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "prepare": "husky",
    "reinstall": "rimraf ./package-lock.json ./node_modules && npm i",
    "cleanup": "rimraf ./lib",
    "precompile:dev": "npm run format && npm run lint",
    "compile:dev": "npm run compile -- -p tsconfig.dev.json",
    "precompile": "npm run cleanup",
    "compile": "tsc",
    "compile:w": "npm run compile -- -w",
    "format": "prettier --log-level error --write .",
    "lint": "eslint --fix",
    "prebundle": "npm run cleanup",
    "bundle": "rollup -c",
    "prewpilgen": "npm run format && npm run lint && npm run compile",
    "wpilgen": "node ./lib/cli.js"
  },
  "dependencies": {
    "simple-git": "^4.0.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/node": "~22.18.0",
    "@types/yargs": "~17.0.24",
    "builtin-modules": "^5.4.0",
    "eslint": "^10.0.0",
    "eslint-import-resolver-typescript": "^4.0.0",
    "eslint-plugin-import-x": "^4.0.0",
    "eslint-plugin-perfectionist": "^5.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.64.0",
    "rollup-plugin-esbuild": "^6.2.0",
    "rollup-plugin-preserve-shebangs": "^0.2.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
