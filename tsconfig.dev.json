{
  "compilerOptions": {
    "lib": ["es2025"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "newLine": "lf",
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "rootDir": "src",
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es2025",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
