{
  "compilerOptions": {
    "lib": ["es2022"],
    "module": "node20",
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "outDir": "lib",
    "rootDir": "src",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "es6",
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
